# Conjure Fitness — environment configuration
#
# All values are optional. With NONE of them set, the app runs entirely on
# the in-memory + VFS mock data layer, so `npm run dev` works end-to-end with
# zero backend. This is the supported path for contributors running locally.
#
# Set the Supabase pair to point the data layer at a real backend (see
# supabase/ for the schema + edge functions and README for the deploy runbook).

# --- Supabase backend (optional; mock is used when unset) ---
# Project REST URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Project anon/publishable key. Safe to ship in the bundle — RLS + anonymous
# auth gate every row to the signed-in (anonymous or email) user.
VITE_SUPABASE_ANON_KEY=

# --- USDA FoodData Central (optional) ---
# Used for generic whole-food text search. Defaults to DEMO_KEY (30 req/hr per
# IP). Get a free key at https://api.data.gov/signup/ for 1000 req/hr.
VITE_USDA_API_KEY=

# Open Food Facts (barcodes + branded items) needs no key.
